{
  "appId": "com.majiastudios.robits",
  "appName": "ROBITS",
  "webDir": "dist",
  "backgroundColor": "#04060cff",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#04060cff",
    "scrollEnabled": false,
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "backgroundColor": "#04060cff",
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#04060cff",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true,
      "backgroundColor": "#04060cff"
    }
  }
}
